# When deployed as a Databricks App, DATABRICKS_HOST and DATABRICKS_TOKEN
# are injected automatically. Only set these for local development.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# SQL Warehouse to execute queries against
DATABRICKS_WAREHOUSE_ID=

# Unity Catalog name for the business data catalog
DATABRICKS_CATALOG=main

# FastAPI server settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
